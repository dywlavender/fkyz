# Mirror every application/model event to the IDE console in real time.
RISK_REVIEW_LOG_TO_CONSOLE=0

# LangChain Agent runs in the Web service process and global worker threads.
RISK_REVIEW_AGENT_PROVIDER=anthropic
RISK_REVIEW_AGENT_MODEL=your-model-name
RISK_REVIEW_AGENT_TEMPERATURE=0
RISK_REVIEW_AGENT_MAX_TOKENS=12000
RISK_REVIEW_AGENT_TIMEOUT=600
RISK_REVIEW_AGENT_MAX_STEPS=20

# Anthropic provider. Keep secrets only in .env, never commit them.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=

# OpenAI-compatible alternative
# RISK_REVIEW_AGENT_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

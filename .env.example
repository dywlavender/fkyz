# Runtime backend used before system settings are persisted: claude | agent
RISK_REVIEW_MODEL_BACKEND=claude

# Mirror every application/model event to the IDE console in real time.
RISK_REVIEW_LOG_TO_CONSOLE=0

# Claude CLI
RISK_REVIEW_CLAUDE_CMD=claude
RISK_REVIEW_CLAUDE_ARGS=-p --output-format text --model your-model-name
RISK_REVIEW_CLAUDE_TIMEOUT=600

# LangChain agent process
RISK_REVIEW_AGENT_PYTHON=/opt/miniconda3/envs/langchain1.2/bin/python
RISK_REVIEW_AGENT_PROVIDER=anthropic
RISK_REVIEW_AGENT_MODEL=your-model-name
RISK_REVIEW_AGENT_TEMPERATURE=0
RISK_REVIEW_AGENT_MAX_TOKENS=12000
RISK_REVIEW_AGENT_TIMEOUT=600
RISK_REVIEW_AGENT_TEST_TIMEOUT=30
RISK_REVIEW_AGENT_MAX_STEPS=20

# Anthropic provider. Keep secrets only in .env, never commit them.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=

# OpenAI-compatible alternative
# RISK_REVIEW_AGENT_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
